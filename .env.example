# ===== 무료 기본 구성 (이 값들만 있으면 동작) =====
# Gemini API 키 (대본 생성). 결제가 연결되지 않은 Google Cloud 프로젝트에서 발급해야 무료 티어 적용.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash
GEMINI_DAILY_TEXT_CAP=50
# pollinations.ai 무료 이미지 (키 불필요) 일일 상한
POLLINATIONS_DAILY_CAP=100
# 장면 이미지 고정: 0이면 매번 랜덤, 숫자를 넣으면 같은 프롬프트에서 같은 그림 재현
IMAGE_SEED=0
# 이미지 프롬프트 뒤에 붙는 스타일 (입 다물고 정면을 보게 해야 영상 변환이 자연스럽다)
IMAGE_STYLE_SUFFIX=mouth closed, looking at the camera, centered, full body visible, photorealistic, sharp focus, vertical 9:16
# edge-tts 목소리 (무료)
TTS_VOICE_ANIMAL=ko-KR-SunHiNeural
TTS_VOICE_REPORTER=ko-KR-InJoonNeural

# ===== 비용 가드 =====
# false(기본)면 아래 유료 공급자는 키가 있어도 실행 전에 차단됨
ALLOW_PAID=false
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
KLING_API_KEY=
KLING_BASE_URL=https://api-singapore.klingai.com
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ANIMAL=
ELEVENLABS_VOICE_REPORTER=

# ===== 이미지→영상 =====
# auto: assets/clips 에 mp4가 있으면 local, NVIDIA GPU+diffusers 가 있으면 ltx(로컬 무료 AI), 아니면 kenburns
VIDEO_PROVIDER=auto
LTX_MODEL=Lightricks/LTX-Video-0.9.5
LTX_WIDTH=512
LTX_HEIGHT=896
LTX_NUM_FRAMES=97
LTX_STEPS=30
LTX_GUIDANCE=3.0
LTX_SEED=42
LTX_ATTENTION_BACKEND=_native_efficient
MODELS_DIR=models

# ===== 렌더링/출력 =====
FONT_PATH=C:/Windows/Fonts/malgunbd.ttf
OUTPUT_DIR=output
ASSETS_DIR=assets
# 사내망 SSL 검사 대응 (Windows 인증서 저장소 사용)
USE_OS_TRUSTSTORE=true

# ===== 배포 (비워두면 배포 안 함) =====
# youtube,instagram
AUTO_PUBLISH=
YOUTUBE_PRIVACY=private
YOUTUBE_CLIENT_SECRETS=client_secrets.json
YOUTUBE_TOKEN=token.json
IG_USER_ID=
IG_ACCESS_TOKEN=
# 인스타 릴스는 공개 URL 필요: none | catbox | copydir
IG_MEDIA_HOST=none
IG_COPYDIR_PATH=
IG_COPYDIR_BASE_URL=
